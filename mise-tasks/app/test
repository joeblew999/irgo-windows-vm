#!/usr/bin/env bash
#MISE description="Put a binary on a VM, run it, and remove it"
#MISE depends=["go:tool"]
set -euo pipefail
exe="$MISE_PROJECT_ROOT/.bin/win/probe.exe"
GOOS=windows GOARCH=arm64 CGO_ENABLED=0 go -C examples build -trimpath -ldflags="-s -w" -o "$exe" ./probe
# No precondition check here any more. It shelled out to `utmctl ip-address` to
# decide whether the guest agent was up, which meant this file held both the
# VM's name and a second opinion about what "ready" means -- and app-create
# already answers that, recovers a VM that has rebooted, and says what to run
# if Windows is not installed yet.
#
# examples/probe, not a throwaway: this once ran `go build` into a mktemp
# hello.exe, which tested a path no user takes.
echo "=== create: push it and run it ==="
irgo-winvm app-create "$exe"

echo
echo "=== delete: take it off again ==="
irgo-winvm app-delete "$exe"

echo
echo "=== deleting again is success, not an error ==="
irgo-winvm app-delete "$exe"

echo
echo "app create and delete cycle complete"
