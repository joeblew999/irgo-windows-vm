<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if eq .Title "irgo-windows-vm"}}{{.Title}}{{else}}{{.Title}} — irgo-windows-vm{{end}}</title>
<meta name="description" content="{{.Blurb}}">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header class="top">
  <a class="wordmark" href="index.html">irgo-windows-vm</a>
  <nav>
    {{range .Nav}}<a href="{{.Href}}"{{if .Current}} class="current" aria-current="page"{{end}}>{{.Title}}</a>{{end}}
    <a class="gh" href="{{$.Repo}}">GitHub</a>
  </nav>
</header>

<main>
  <article class="prose">
    {{.Body}}
  </article>

  {{/*
    A gallery, and no prose. There was a paragraph here describing what the
    screenshots showed, which was a claim this template made on its own account
    — the words appeared in no markdown file, so the repository could change
    what it proves and this would have gone on saying the old thing.
    Screenshots and their filenames come from docs/screens; the heading is a
    label, like the navigation.
  */}}
  {{if .Screens}}
  <section class="evidence">
    <h2 id="evidence">Screenshots</h2>
    <div class="shots">
      {{range .Screens}}
      <figure>
        <a href="screens/{{.}}"><img src="screens/{{.}}" alt="{{.}}" loading="lazy"></a>
        <figcaption>{{.}}</figcaption>
      </figure>
      {{end}}
    </div>
  </section>
  {{end}}
</main>

<footer>
  <p>Generated from the markdown in the repository — if this page is wrong, the
  markdown is wrong. Reading with a machine?
  <a href="llms.txt">llms.txt</a> ·
  <a href="llms-full.txt">the whole thing in one file</a><br>
  <a href="{{.Repo}}">Source</a> ·
  <a href="{{.Repo}}/releases">Releases</a> ·
  <a href="{{.Repo}}/blob/main/LICENSE">MIT</a></p>
</footer>

</body>
</html>
