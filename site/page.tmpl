<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if .Home}}{{.Site}}{{else}}{{.Title}} — {{.Site}}{{end}}</title>
<meta name="description" content="{{.Blurb}}">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="style.css">
<link rel="stylesheet" href="syntax.css">
<!--
  Anything that fetched this page can find the whole corpus from here, without
  knowing the llms.txt convention and without having rendered the footer. Asked
  how to read these docs, a capable model recommended scraping the repository's
  raw markdown instead — which silently omits the command reference, because
  that page is captured from the binary and has no source file.
-->
<link rel="alternate" type="text/plain" href="llms-full.txt" title="All documentation as one file">
<link rel="alternate" type="text/plain" href="llms.txt" title="Documentation index for machines">
</head>
<body class="{{if .Home}}home{{end}}{{if .TOC}} has-toc{{end}}">

<!--
  No id on anything in this template: every id on the page belongs to a
  heading, and a heading called "Content" or "Main" would otherwise collide
  with the template's and one of the two would stop being linkable.
  TestNoDuplicateIDs is what notices.
-->

<header class="top">
  <div class="top-inner">
    <a class="wordmark{{if .Home}} current{{end}}" href="index.html"{{if .Home}} aria-current="page"{{end}}>{{.Site}}</a>
    <nav class="top-nav" aria-label="Site">
      {{range .Nav}}<a href="{{.Href}}" title="{{.Blurb}}"{{if .Current}} class="current" aria-current="page"{{end}}>{{.Title}}</a>{{end}}
    </nav>
    <a class="gh" href="{{$.Repo}}" aria-label="Source on GitHub"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span>GitHub</span></a>
  </div>
</header>

<div class="layout">
  {{if .TOC}}
  <details class="toc toc-inline">
    <summary>On this page</summary>
    {{.TOC}}
  </details>
  {{end}}

  <main>
    <article class="prose">
      {{.Body}}
    </article>
  </main>

  {{if .TOC}}
  <aside class="toc toc-side" aria-label="On this page">
    <p class="toc-title">On this page</p>
    {{.TOC}}
  </aside>
  {{end}}
</div>

<footer>
  <div class="footer-inner">
  <p>
  {{- if .Source}}Generated from <a href="{{.Repo}}/blob/main/{{.Source}}">{{.Source}}</a> in the repository — if this page is wrong, that file is wrong.
  {{- else}}Captured from the compiled binary at build time, so no flag or default is ever transcribed — if this page is wrong, the Go code is wrong and no markdown will fix it.
  {{- end}}</p>
  <p>Reading with a machine?
  <a href="llms.txt">llms.txt</a> ·
  <a href="llms-full.txt">the whole thing in one file</a></p>
  <p><a href="{{.Repo}}">Source</a> ·
  <a href="{{.Repo}}/releases">Releases</a> ·
  <a href="{{.Repo}}/blob/main/LICENSE">MIT</a></p>
  {{if .Build}}<p class="stamp">{{.Build}}</p>{{end}}
  </div>
</footer>

<!--
  The only script, and the page works without it: copy buttons on code blocks,
  the current section marked in the sidebar, and the inline contents closed on
  a phone. Inline rather than a file, so there is nothing more to fetch.
-->
<script>
(function () {
  document.querySelectorAll(".prose pre").forEach(function (pre) {
    var box = pre.closest(".codeblock");
    if (!box) {
      box = document.createElement("div");
      box.className = "codeblock";
      pre.parentNode.insertBefore(box, pre);
      box.appendChild(pre);
    }
    var b = document.createElement("button");
    b.type = "button";
    b.className = "copy";
    b.textContent = "Copy";
    b.addEventListener("click", function () {
      var done = function (label) {
        b.textContent = label;
        setTimeout(function () { b.textContent = "Copy"; }, 1600);
      };
      if (!navigator.clipboard) { done("Not allowed"); return; }
      navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""))
        .then(function () { done("Copied"); }, function () { done("Not allowed"); });
    });
    box.appendChild(b);
  });

  // On a phone the nav scrolls sideways, and "MCP" starts off-screen on its
  // own page. Bring the current entry into view so the you-are-here cue shows.
  var here = document.querySelector(".top-nav a.current");
  if (here && here.parentNode.scrollWidth > here.parentNode.clientWidth) {
    here.parentNode.scrollLeft = here.offsetLeft - here.parentNode.offsetLeft - 16;
  }

  var side = document.querySelector(".toc-side");
  if (!side || !("IntersectionObserver" in window)) return;
  var links = {};
  side.querySelectorAll("a[href^='#']").forEach(function (a) {
    links[decodeURIComponent(a.getAttribute("href").slice(1))] = a;
  });
  var current = side.querySelector("a[href^='#']");
  if (current) current.classList.add("active");
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting || !links[e.target.id]) return;
      if (current) current.classList.remove("active");
      current = links[e.target.id];
      current.classList.add("active");
    });
  }, { rootMargin: "0px 0px -75% 0px" });
  document.querySelectorAll(".prose h2[id], .prose h3[id]").forEach(function (h) { obs.observe(h); });
})();
</script>
</body>
</html>
