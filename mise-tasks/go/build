#!/usr/bin/env bash
#MISE description="Build irgo-winvm for every Mac a user could have, into dist/, as a release would"
set -euo pipefail
# .goreleaser.yaml is the build: targets, flags, names, SHA256SUMS, and why each
# is what it is. This only picks the mode.
#
# The version is compiled in, so it is part of the bytes. A clean checkout of a
# tag builds what release.yml published for that tag -- same version string,
# same checksums -- which is the point of a maintainer being able to run this.
# Anything else is a snapshot and says `dev`.
#
# That was false once. CI set VERSION from the tag it was building; a maintainer
# checking what would be published ran the same task by hand, got `dev`, and so
# got different bytes. Everything published said the checksums were
# reproducible with this command; they were reproducible with
# `VERSION=v0.2.0 mise run go:build`, which nothing said.
#
# --exact-match, so only a commit that *is* a release claims to be one. A commit
# after the tag is a snapshot rather than claiming the tag below it. --dirty is
# not available with it, which is why the tree check is separate: uncommitted
# changes are not the release, whatever the tag says.
#
# --skip=publish builds and checksums without touching GitHub.
if git describe --tags --exact-match HEAD >/dev/null 2>&1 && [ -z "$(git status --porcelain)" ]; then
  goreleaser release --clean --skip=publish
else
  goreleaser release --clean --snapshot
fi
cat dist/SHA256SUMS
