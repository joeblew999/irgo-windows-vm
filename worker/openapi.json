{
  "components": {
    "schemas": {
      "BlobInfo": {
        "properties": {
          "key": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "key",
          "size"
        ],
        "type": "object"
      },
      "Error": {
        "$ref": "#/components/schemas/Error"
      },
      "GlazeLatest": {
        "additionalProperties": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/GlazeRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "GlazePosted": {
        "properties": {
          "pictures": {
            "type": "integer"
          },
          "run": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "run",
          "pictures"
        ],
        "type": "object"
      },
      "GlazeRun": {
        "properties": {
          "base": {
            "type": "string"
          },
          "manifest": {
            "description": "any JSON, stored and returned as it was posted"
          },
          "received": {
            "format": "date-time",
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "run",
          "received",
          "base",
          "manifest"
        ],
        "type": "object"
      },
      "GoldenList": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/BlobInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "objects",
          "cursor"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "glaze-status-write": {
        "description": "CI's conformance job posting a glaze run. The Worker's secret GLAZE_STATUS_TOKEN; clients read it from GLAZE_STATUS_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      },
      "golden-read": {
        "description": "reading the golden image: every machine that pulls. The Worker's secret GOLDEN_TOKEN; clients read it from IRGO_GOLDEN_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      },
      "golden-write": {
        "description": "writing, deleting and listing it: only where you push. The Worker's secret GOLDEN_PUSH_TOKEN; clients read it from IRGO_GOLDEN_PUSH_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The Cloudflare Worker's API: live glaze status and the private golden image. Generated from the route table in wire/routes.go, the same table the Worker routes by and the clients build URLs from. Every error is an Error whose code is one of: `bad-request` (400): the request is malformed; the message says how; `digest-mismatch` (400): the body did not hash to X-Golden-Sha256; nothing was stored; `unauthorized` (401): no valid bearer token for this route's scope, whatever the path, so a caller without one learns nothing; `not-found` (404): no such route, object, target or key; `method-not-allowed` (405): the path exists, not with this method; Allow lists the ones it has; `conflict` (409): refused against what is stored: an older glaze run, an unreadable record, or an object replaced while being read; `length-required` (411): send Content-Length: R2 stores a stream only of known length; `too-large` (413): the body is over the route's limit; `unsupported-media-type` (415): the body is not the route's media type; `range-not-satisfiable` (416): the Range starts past the end of the object; `internal` (500): a bucket binding is missing, or an answer could not be encoded; `storage` (502): R2 failed, or a write did not read back as written; `not-configured` (503): the secret for this route's scope is not set on the Worker, so it refuses everything.",
    "title": "irgo-windows-vm Worker",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/glaze-status": {
      "get": {
        "operationId": "glaze-latest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlazeLatest"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code internal"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code storage"
          }
        },
        "security": [],
        "summary": "the newest glaze run per target (null for a target with none), read by the site's Glaze status page",
        "x-scope": "none"
      }
    },
    "/api/glaze-status/{target}": {
      "post": {
        "operationId": "glaze-post",
        "parameters": [
          {
            "description": "mac or windows; must match the manifest's Target",
            "in": "path",
            "name": "target",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "additionalProperties": {
                  "contentMediaType": "image/png",
                  "type": "string"
                },
                "description": "one part named manifest holding shots.json, and one part per picture it names, named by its file name (at most 64, each a PNG of at most 4194304 bytes)",
                "properties": {
                  "manifest": {
                    "contentMediaType": "application/json",
                    "type": "string"
                  }
                },
                "required": [
                  "manifest"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlazePosted"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code bad-request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code not-found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code too-large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code unsupported-media-type"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code internal"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code storage"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "code not-configured"
          }
        },
        "security": [
          {
            "glaze-status-write": []
          }
        ],
        "summary": "record a run: its shots.json and every picture it names, as CI's conformance job sends them. Refused when older than the stored run, so a re-run of an old workflow cannot roll the page back",
        "x-irgo-winvm-commands": [
          "glaze-check"
        ],
        "x-max-body": 16777216,
        "x-scope": "glaze-status-write"
      }
    },
