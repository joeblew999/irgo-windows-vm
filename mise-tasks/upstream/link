#!/usr/bin/env bash
#MISE description="Point every module at the LOCAL glaze/native clones"
set -euo pipefail
# One go.work at the root listing every module. `use` alone is not enough:
# without the replaces the workspace still resolves glaze from the module cache
# at the version in go.mod, and the edit being tested is silently ignored — a
# build that looks like it proves something and proves nothing.
for repo in glaze native; do
  if [ ! -d "$UPSTREAM_DIR/$repo" ]; then
    echo "missing $UPSTREAM_DIR/$repo — run: mise run upstream:clone" >&2
    exit 1
  fi
done
# examples/drive needs native's input and screen packages, which examples/go.mod
# takes from the joeblew999/native fork until crgimenes releases them. The
# go.work replace below overrides that, so a clone without them cannot build
# examples. Said here, before the build fails with "no required module
# provides package github.com/crgimenes/native/input".
for pkg in input screen; do
  if [ ! -d "$UPSTREAM_DIR/native/$pkg" ]; then
    echo "warning: $UPSTREAM_DIR/native has no $pkg/ — examples will not build linked until it does:" >&2
    echo "  git -C $UPSTREAM_DIR/native fetch https://github.com/joeblew999/native feat/input-screen-darwin && git -C $UPSTREAM_DIR/native merge FETCH_HEAD" >&2
    break
  fi
done
cd "$MISE_PROJECT_ROOT"
rm -f go.work go.work.sum
# Every module in the repo (site/ was added after these tasks were first
# written; a hand list goes stale), then the two replaces.
go work init
# Every tracked module, from git: `go work use -r .` also picked up agent
# worktrees under .claude/ and stray modules under .plans/ (1 Oct 2026).
git ls-files '*go.mod' ':!:.claude/**' ':!:.plans/**' | xargs -n1 dirname | xargs go work use
go work edit -replace "github.com/crgimenes/glaze=$UPSTREAM_DIR/glaze" \
             -replace "github.com/crgimenes/native=$UPSTREAM_DIR/native"
echo "linked. every module now builds against:"
echo "  $UPSTREAM_DIR/glaze ($(git -C "$UPSTREAM_DIR/glaze" branch --show-current))"
echo "  $UPSTREAM_DIR/native ($(git -C "$UPSTREAM_DIR/native" branch --show-current))"
echo "undo with: mise run upstream:unlink"
