#!/usr/bin/env bash
#MISE description="Create a VM and delete it, against a disposable name"
#MISE depends=["go:tool"]
set -euo pipefail
VM=irgo-test-cycle

# vm-create no longer restarts UTM (UTM imports the bundle), so running VMs are
# left alone and there is nothing to guard against. -golden=false: with a golden
# image present, vm-create would clone and boot one instead of making a bundle.

echo "=== create ==="
irgo-winvm vm-create -vm "$VM" -golden=false

echo
echo "=== it exists ==="
utmctl status "$VM" || { echo "UTM does not know $VM" >&2; exit 1; }

echo
echo "=== delete refuses without -force ==="
if irgo-winvm vm-delete -vm "$VM"; then
  echo "vm-delete deleted without -force" >&2; exit 1
fi

echo
echo "=== delete ==="
irgo-winvm vm-delete -vm "$VM" -force

echo
echo "=== it is gone, and no phantom entry is left ==="
if utmctl status "$VM" 2>/dev/null; then
  echo "$VM still registered with UTM" >&2; exit 1
fi

echo
echo "=== deleting again is success, not an error ==="
irgo-winvm vm-delete -vm "$VM"

echo
echo "create and delete cycle complete"
