# Generated media and disks — rebuild with `irgo-winvm create`
*.iso
*.dmg
*.img
/out/

# Large downloaded media and generated payloads. fetch-iso will populate .cache/;
# nothing here belongs in git.
/.cache/

# Probe binaries built by `mise run probes`. Rebuildable from source in seconds;
# they exist so a restart does not lose them, not so they are committed.
/.bin/

# go.work files point at absolute paths on one machine. `mise run upstream:verify`
# writes one to test against local glaze/native clones and removes it again.
go.work
go.work.sum
.bin/

# Release artefacts, built by mise run go:build.
/dist/

# Probe binaries built into their own source directory. `go build` with no -o
# drops one next to main.go, and probe/nativeprobe was committed that way — a
# 4.5 MB build artefact in a repository whose largest real file is a screenshot.
/probe/nativeprobe
/glaze-probes/verify
/glaze-probes/verifyevents
/examples/glaze-all/glaze-all

# The generated site. Built by `mise run site:build` from the markdown, which is
# the source of truth; committing the output would be the second copy the
# generator exists to avoid.
/site/dist/
